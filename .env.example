# Dhaka Tesla Pool — environment variables (example only).
# Copy to .env and fill in real values locally. NEVER commit real secrets.

# --- Common ---
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Used directly by the API and by docker-compose.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dhaka_tesla_pool
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=dhaka_tesla_pool

# --- API (apps/api) ---
API_PORT=3001
# Secret used to sign session cookies. Generate a long random value locally.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Web (apps/web) ---
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Docker / compose (overrides for container networking) ---
# Used when running the API inside Docker so it reaches the compose DB service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dhaka_tesla_pool