# Dhaka Tesla Pool — environment variables (example only).
# Copy to `.env` and fill in real values locally. NEVER commit real secrets.
# `.env` and `.env.*` are git-ignored (see .gitignore).
#
# Clerk authentication (docs/decisions.md ADR-013):
#   - Create an application at https://dashboard.clerk.com and copy its keys.
#   - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (web) is safe to embed in the browser.
#   - CLERK_SECRET_KEY (api) is a server secret — never expose it to the client
#     and never commit it. The values below are INVALID build-only placeholders;
#     replace them before running authenticated flows.
#   - CLERK_AUTHORIZED_PARTIES (api) lists the origins allowed to present Clerk
#     session tokens to the API (CSRF / subdomain cookie-leak defence). Defaults
#     to WEB_URL when unset.

# --- Common ---
NODE_ENV=development

# --- API (apps/api) ---
# Bind address. 0.0.0.0 is required inside Docker; 127.0.0.1 is fine locally.
API_HOST=0.0.0.0
API_PORT=3001
# The web app's public origin (Clerk authorized party default + CORS domain).
WEB_URL=http://localhost:3000
# Clerk API keys (SERVER-side only).
# NOTE: this placeholder is deliberately NOT shaped like a real Clerk secret key
# (sk_test_/sk_live_) so that secret scanners in git hosting do not misflag it.
CLERK_SECRET_KEY=sk_placeholder-not-a-real-clerk-secret-key-do-not-use-000000
CLERK_PUBLISHABLE_KEY=pk_test_cGxhY2Vob2xkZXIuaW52YWxpZC5jbGVyay5hY2NvdW50cy5kZXYk
# Comma-separated origins allowed to authenticate against this API. Unset = WEB_URL.
# E.g. CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://web.example.com
CLERK_AUTHORIZED_PARTIES=

# --- Web (apps/web) ---
# Browser-visible base URL of the API.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Clerk publishable key (BROWSER-safe; public by design).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cGxhY2Vob2xkZXIuaW52YWxpZC5jbGVyay5hY2NvdW50cy5kZXYk

# --- Database (PostgreSQL) ---
# Used by the API for LOCAL runs (host Postgres via Docker: docker compose up db).
# Inside the Docker compose stack the api service overrides this with the `db`
# host (see docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dhaka_tesla_pool

# --- Docker compose (Postgres container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dhaka_tesla_pool